# DyslexiMate Environment Variables
# Copy this file to .env and fill in your Supabase project credentials.
# Note: In Cloudflare Pages, configure these under Settings > Environment Variables.

# Supabase Project URL (e.g., https://your-project-ref.supabase.co)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous/Publishable API Key (safe for frontend use with RLS enabled)
# Never put your service_role secret here!
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# =============================================================================
# TinyFish Web Discovery Integration (SERVER-SIDE ONLY)
# =============================================================================
# Obtain your API key from TinyFish (https://tinyfish.ai).
# IMPORTANT:
# - Do NOT prefix with VITE_. This secret must NEVER be exposed in the frontend client bundle!
# - For local development: set TINYFISH_API_KEY below (read by Vite proxy middleware).
# - For Cloudflare Workers production: configure via wrangler secret:
#     npx wrangler secret put TINYFISH_API_KEY
TINYFISH_API_KEY=your-tinyfish-api-key-here

