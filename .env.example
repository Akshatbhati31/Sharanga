# DyslexiMate Environment Variables
# Copy this file to .env and fill in your Supabase project credentials.
# Note: In Cloudflare Pages, configure these under Settings > Environment Variables.

# Supabase Project URL (e.g., https://your-project-ref.supabase.co)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous/Publishable API Key (safe for frontend use with RLS enabled)
# Never put your service_role secret here!
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
