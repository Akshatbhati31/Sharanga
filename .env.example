# DyslexiMate Environment Variables (Vercel & Local Development)
# Copy this file to .env for local development.
# For Vercel deployments, configure these in:
#   Vercel Dashboard > Project Settings > Environment Variables

# =============================================================================
# Supabase Integration (CLIENT-SIDE SAFE - PUBLIC KEYS)
# =============================================================================
# Supabase Project URL (e.g., https://your-project-ref.supabase.co)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous/Publishable API Key (safe for frontend use with RLS enabled)
# WARNING: Never put your service_role secret here!
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# =============================================================================
# Google Gemini AI Integration (SERVER-SIDE ONLY - SECRET)
# =============================================================================
# Obtain your API key from Google AI Studio (https://aistudio.google.com).
# WARNING: Do NOT prefix with VITE_. This secret must NEVER be exposed to the browser!
# Server-side API key for generating personalized dyslexia learning activities:
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: Specify supported Gemini model (defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# =============================================================================
# TinyFish Web Discovery Integration (SERVER-SIDE ONLY - SECRET)
# =============================================================================
# Obtain your API key from TinyFish (https://tinyfish.ai).
# WARNING: Do NOT prefix with VITE_. This secret must NEVER be exposed to the browser!
# Server-side API key for retrieving verified educational learning resources:
TINYFISH_API_KEY=your-tinyfish-api-key-here

